# Copia este archivo a .env para probar en tu PC (npm run dev).
# En Render estas variables se ponen en Environment, NO se sube el .env a GitHub.

# Token del bot (Discord Developer Portal > tu app > Bot > Reset Token)
DISCORD_TOKEN=

# IDs de tus servidores de Discord, separados por comas, sin espacios.
# (Clic derecho al servidor > Copiar ID). El bot debe estar invitado a todos.
# Con un solo servidor, pon solo un ID.
GUILD_IDS=

# Canales donde llegan las alertas por defecto, separados por comas.
# (Clic derecho al canal > Copiar ID). Reciben las alertas de TODOS los juegos
# que no tengan una ruta propia en GAME_ROUTES.
ALERT_CHANNEL_IDS=

# OPCIONAL: rutas por juego. Si el placeId de un juego aparece aquí, sus alertas
# van SOLO a esos canales (en vez de a los de ALERT_CHANNEL_IDS). Formato JSON en una línea:
# GAME_ROUTES={"123456789":["idCanalA"],"987654321":["idCanalB","idCanalC"]}
GAME_ROUTES=

# Clave secreta compartida con Roblox. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Render define PORT solo. Local: 3000
PORT=3000

# 1 = no se conecta a Discord, solo imprime los embeds en consola (para probar)
DRY_RUN=0
